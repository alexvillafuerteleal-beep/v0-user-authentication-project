# PagoIA Environment Configuration Template
# Copy to .env.local and fill in actual values

# ===== SUPABASE =====
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===== STRIPE =====
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_or_pk_live
STRIPE_SECRET_KEY=sk_test_or_sk_live
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Métodos de pago en Checkout. "card,oxxo" requiere una cuenta de Stripe registrada en México.
STRIPE_PAYMENT_METHODS=card
# Pagos automáticos: con llaves reales (sk_live_) los cobros están apagados salvo que pongas "true".
# PagoIA no le paga al proveedor del servicio, así que déjalo apagado fuera de pruebas.
AUTOPAY_ALLOW_LIVE=false

# ===== WEB PUSH (VAPID) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ===== SENTRY (ERROR TRACKING) =====
NEXT_PUBLIC_SENTRY_DSN=https://key@sentry.io/project_id
SENTRY_DSN=https://key@sentry.io/project_id
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ===== APPLICATION =====
NODE_ENV=development
NEXT_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PagoIA

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/pagoia

# ===== JWT =====
JWT_SECRET=your_long_random_secret_key_min_32_chars

# ===== VERCEL =====
VERCEL_ENV=development
VERCEL_URL=

# ===== OPTIONAL: Analytics =====
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ===== IA: asistente y escaneo de recibos =====
# Sin esta llave el chat usa el asistente por palabras clave y el escaneo de recibos se desactiva.
ANTHROPIC_API_KEY=

# ===== Tareas programadas =====
# Vercel Cron manda "Authorization: Bearer <CRON_SECRET>" a /api/cron/daily.
CRON_SECRET=

# ===== Correo de recordatorios (opcional, Resend) =====
RESEND_API_KEY=
EMAIL_FROM="PagoIA <recordatorios@tu-dominio.com>"

# ===== Recordatorios por WhatsApp (opcional, Cloud API de Meta) =====
# Necesitas una cuenta de WhatsApp Business verificada y una plantilla aprobada con 3 variables.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=recordatorio_pago
WHATSAPP_TEMPLATE_LANG=es_MX

# ===== Pruebas de aislamiento (e2e/rls-aislamiento.spec.ts) =====
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
